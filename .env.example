# docker compose reads .env: copy this file to .env and fill it in
HF_TOKEN=hf_xxx              # a Hugging Face token with access to the gated models (their first download)
VOXCPM_API_KEY=change-me     # clients send Authorization: Bearer <key>
COMPOSE_PROFILES=http        # http or ws; both: give ws another GPU (device_ids in docker-compose.yml)
